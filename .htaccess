Options -MultiViews +FollowSymLinks
RewriteEngine On
RewriteBase /

<IfModule mod_headers.c>
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</IfModule>

# 1. Redirect direct /index.php to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index\.php\ HTTP/
RewriteRule ^index\.php$ / [R=302,L]

# 2. Redirect direct *.php to clean URL (only on external browser request)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(about|courses|services|consulting|contact|faq|legal|resources)\.php [NC]
RewriteRule ^(about|courses|services|consulting|contact|faq|legal|resources)\.php$ /$1 [R=302,L]

# 3. Dynamic course & resource detail routes
RewriteRule ^courses/([a-zA-Z0-9_-]+)/?$ course-detail.php?c=$1 [L,QSA]
RewriteRule ^resources/([a-zA-Z0-9_-]+)/?$ resource-detail.php?r=$1 [L,QSA]

# 4. Admin panel
RewriteRule ^panel/?$ panel/index.php [L,QSA]

# 5. Explicit Clean Page Routes
RewriteRule ^about/?$ about.php [L,QSA]
RewriteRule ^courses/?$ courses.php [L,QSA]
RewriteRule ^services/?$ services.php [L,QSA]
RewriteRule ^consulting/?$ consulting.php [L,QSA]
RewriteRule ^contact/?$ contact.php [L,QSA]
RewriteRule ^faq/?$ faq.php [L,QSA]
RewriteRule ^legal/?$ legal.php [L,QSA]
RewriteRule ^resources/?$ resources.php [L,QSA]
